{
  "name": "careerloom",
  "private": true,
  "version": "0.4.1",
  "description": "Desktop job-search engine for career-ops, driven by your agent CLI or any API-key model",
  "main": "dist/electron/main.js",
  "scripts": {
    "build:electron": "node -e \"require('fs').rmSync('dist/electron',{recursive:true,force:true})\" && tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "dev": "npm run build:electron && concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "package:linux": "npm run build && electron-builder --linux",
    "fetch-runtime:win": "node scripts/fetch-runtime.mjs win32-x64 win32-arm64",
    "package:win": "npm run build && npm run fetch-runtime:win && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289",
    "react-resizable-panels": "^4.14.1",
    "sonner": "^2.0.8",
    "tldts": "^7.4.16",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^3.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.7.0",
    "electron-builder": "^26.15.3",
    "gsap": "^3.15.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.48.0",
    "lz-string": "^1.5.0",
    "marked": "^18.0.14",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "app.careerloom.desktop",
    "productName": "Careerloom",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/electron/**/*",
      "!dist/electron/**/*.map",
      "dist/renderer/**/*",
      "!node_modules/pdfjs-dist/{build,web,types,image_decoders,cmaps,standard_fonts,wasm}/**",
      "!node_modules/pdfjs-dist/legacy/{web,image_decoders}/**",
      "!node_modules/pdfjs-dist/**/*.map",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Careerloom listens through your microphone during an interview practice or live session you start. Audio is transcribed on this computer and is not stored.",
        "NSAudioCaptureUsageDescription": "Careerloom can capture the interviewer's audio from your call app during a live session you start. Audio is transcribed on this computer and is not stored."
      }
    },
    "dmg": {
      "backgroundColor": "#0b0e13",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 100,
      "contents": [
        {
          "x": 150,
          "y": 180,
          "type": "file"
        },
        {
          "x": 390,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "title": "Careerloom ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "build/runtime/win32-${arch}",
          "to": "runtime",
          "filter": [
            "**/*",
            "!**/.fetched"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "executableName": "careerloom"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Careerloom",
      "uninstallDisplayName": "Careerloom",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "differentialPackage": false
    },
    "copyright": "Copyright © 2026 Vaibhav Chaudhary",
    "toolsets": {
      "nsis": "1.2.1"
    },
    "extraResources": [
      {
        "from": "build/runtime-manifest.json",
        "to": "runtime-manifest.json"
      }
    ]
  },
  "author": "Vaibhav Chaudhary",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/livelong99/careerloom.git"
  },
  "homepage": "https://github.com/livelong99/careerloom"
}
